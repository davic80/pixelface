# pixelface — deployment config
# Copy to .env on the server and adjust:  cp .env.example .env
#
# NOTE: the app is fully static/client-side, so these values are NOT baked into
# the build. They are only used by deploy.sh and your reverse proxy config.

# Public hostname served by your reverse proxy (TLS terminates there).
PIXELFACE_HOST=pixelface.ojoalprecio.com

# Apex domain (for reference / Cloudflare DNS).
PIXELFACE_DOMAIN=ojoalprecio.com

# Local port the container binds to (127.0.0.1 only).
PIXELFACE_PORT=8080

# Image published by GitHub Actions CI.
PIXELFACE_IMAGE=ghcr.io/davic80/pixelface
PIXELFACE_TAG=latest
